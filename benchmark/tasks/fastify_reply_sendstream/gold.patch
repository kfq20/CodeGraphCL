From ed4243255dd6637569a952afab1118ef2de4c7e8 Mon Sep 17 00:00:00 2001
From: Matteo Collina <matteo.collina@gmail.com>
Date: Tue, 30 Jan 2018 19:03:32 +0100
Subject: [PATCH] Support send (#724)

Return an http status code if a stream closes before headers are sent. This enable us to pass the send module stream directly to reply.send().
---
 lib/reply.js | 47 +++++++++++++++++++++++++++++++++++++----------
 1 file changed, 37 insertions(+), 10 deletions(-)

diff --git a/lib/reply.js b/lib/reply.js
index ab98d16e..e7d67b56 100644
--- a/lib/reply.js
+++ b/lib/reply.js
@@ -2,7 +2,7 @@
 
 'use strict'
 
-const pump = require('pump')
+const eos = require('end-of-stream')
 const validation = require('./validation')
 const serialize = validation.serialize
 const statusCodes = require('http').STATUS_CODES
@@ -160,7 +160,7 @@ function onSendEnd (reply, payload) {
   }
 
   if (typeof payload.pipe === 'function') {
-    pump(payload, reply.res, pumpCallback(reply))
+    sendStream(payload, reply.res, reply)
     return
   }
 
@@ -176,15 +176,40 @@ function onSendEnd (reply, payload) {
   reply.res.end(payload)
 }
 
-function pumpCallback (reply) {
-  return function _pumpCallback (err) {
-    if (!err) return
-    if (reply.res.headersSent) {
-      reply.request.log.error(err, 'response terminated with an error with headers already sent')
-    } else {
-      handleError(reply, err)
+function sendStream (payload, res, reply) {
+  var sourceOpen = true
+
+  eos(payload, { readable: true, writable: false }, function (err) {
+    sourceOpen = false
+    if (err) {
+      if (res.headersSent) {
+        res.log.error(err, 'response terminated with an error with headers already sent')
+        res.destroy()
+      } else {
+        handleError(reply, err)
+      }
     }
-  }
+    // there is nothing to do if there is not an error
+  })
+
+  eos(res, function (err) {
+    if (err) {
+      if (res.headersSent) {
+        res.log.error(err, 'response terminated with an error with headers already sent')
+      }
+      if (sourceOpen) {
+        if (payload.destroy) {
+          payload.destroy()
+        } else if (typeof payload.close === 'function') {
+          payload.close(noop)
+        } else if (typeof payload.abort === 'function') {
+          payload.abort()
+        }
+      }
+    }
+  })
+
+  payload.pipe(res)
 }
 
 function handleError (reply, error, cb) {
@@ -256,5 +281,7 @@ function buildReply (R) {
   return _Reply
 }
 
+function noop () {}
+
 module.exports = Reply
 module.exports.buildReply = buildReply
-- 
