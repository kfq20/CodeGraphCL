# CodeGraphCL ripgrep task image.
# Rust toolchain pinned to 1.88 (newest CI version across c2=1.70, c3=1.85, c4=1.88; Rust
# is backwards-compatible so 1.88 should compile all three snapshots).
#
# NO apt layer — rust:1.88-slim already ships cargo/rustc/cc/gcc (verified). Adding apt was
# making the build hang: deb.debian.org is nearly unreachable from this fuse-overlayfs host
# (~85s per package, 100x slower than normal; builds died silently on apt timeout). ripgrep
# default features need no OpenSSL/pkg-config, so we skip apt entirely. If a snapshot turns
# out to need git (e.g. a git-path dep), add ONLY that package later.
#
# NO node/claude here (agent runs on host); this image only provides the Rust build+test env.
# CARGO_HOME + target dir mounted at runtime so the registry + build cache persist across
# episodes (first build ~5-10 min, subsequent <2 min).

FROM rust:1.88-slim

ENV CARGO_TERM_COLOR=never \
    CARGO_NET_GIT_FETCH_WITH_CLI=false

RUN mkdir -p /workspace
WORKDIR /workspace
