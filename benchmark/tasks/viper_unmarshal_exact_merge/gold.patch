From fb6eb1e8e9fbaa424b113248af35f048c5d86dea Mon Sep 17 00:00:00 2001
From: Filip Krakowski <krakowski@hhu.de>
Date: Wed, 6 Dec 2023 22:20:47 +0100
Subject: [PATCH] fix: merge missing struct keys inside UnmarshalExact

---
 viper.go | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/viper.go b/viper.go
index 714b2f2..122280b 100644
--- a/viper.go
+++ b/viper.go
@@ -1179,7 +1179,14 @@ func (v *Viper) UnmarshalExact(rawVal any, opts ...DecoderConfigOption) error {
 	config := defaultDecoderConfig(rawVal, opts...)
 	config.ErrorUnused = true
 
-	return decode(v.AllSettings(), config)
+	// TODO: make this optional?
+	structKeys, err := v.decodeStructKeys(rawVal, opts...)
+	if err != nil {
+		return err
+	}
+
+	// TODO: struct keys should be enough?
+	return decode(v.getSettings(append(v.AllKeys(), structKeys...)), config)
 }
 
 // BindPFlags binds a full flag set to the configuration, using each flag's long
-- 
