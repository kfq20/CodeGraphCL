+      t.equal(line.msg, 'incoming request', 'message is set')
+      t.equal(line.req.method, 'GET', 'method is get')
 
       stream.once('data', line => {
-        const id = line.reqId
+        t.equal(line.reqId, id)
         t.ok(line.reqId, 'reqId is defined')
-        t.ok(line.req, 'req is defined')
-        t.equal(line.msg, 'incoming request', 'message is set')
-        t.equal(line.req.method, 'GET', 'method is get')
-
-        stream.once('data', line => {
-          t.equal(line.reqId, id)
-          t.ok(line.reqId, 'reqId is defined')
