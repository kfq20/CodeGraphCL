From 31c5f7e259d1f4bc2deb766a0b2c95912b8ee668 Mon Sep 17 00:00:00 2001
From: James Sumners <james.sumners@gmail.com>
Date: Wed, 7 Mar 2018 08:04:18 -0500
Subject: [PATCH] Fix setting header multiple times and add utility methods
 (fix #834) (#836)

* Fix setting header multiple times and add utility methods (fix #834)

* Treat set-cookie special per RFC 7230

* Simplify hasHeader
---
 lib/reply.js | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/lib/reply.js b/lib/reply.js
index 7ef6102a..93eaee9a 100644
--- a/lib/reply.js
+++ b/lib/reply.js
@@ -80,8 +80,22 @@ Reply.prototype.send = function (payload) {
   onSendHook(this, payload)
 }
 
+Reply.prototype.getHeader = function (key) {
+  return getHeader(this, key)
+}
+
+Reply.prototype.hasHeader = function (key) {
+  return this._headers[key.toLowerCase()] !== undefined
+}
+
 Reply.prototype.header = function (key, value) {
-  this._headers[key.toLowerCase()] = value
+  var _key = key.toLowerCase()
+  // https://tools.ietf.org/html/rfc7230#section-3.2.2
+  if (this._headers[_key] && _key === 'set-cookie') {
+    this._headers[_key] = [this._headers[_key]].concat(value)
+  } else {
+    this._headers[_key] = value
+  }
   return this
 }
 
-- 
