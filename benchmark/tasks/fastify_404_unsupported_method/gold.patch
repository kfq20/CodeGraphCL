From: Tomas Della Vedova <delvedor@users.noreply.github.com>
Date: Mon, 26 Mar 2018 10:08:02 +0200
Subject: [PATCH] Better handling of 404 routes (#862)

---
 lib/handleRequest.js | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/lib/handleRequest.js b/lib/handleRequest.js
index 894c3034..03ff479b 100644
--- a/lib/handleRequest.js
+++ b/lib/handleRequest.js
@@ -46,7 +46,8 @@ function handleRequest (req, res, params, context) {
     return
   }
 
-  reply.code(405).send(new Error('Method Not Allowed: ' + method))
+  // Return 404 instead of 405 see https://github.com/fastify/fastify/pull/862 for discussion
+  reply.code(404).send(new Error('Not Found'))
 }
 
 function handler (reply) {
